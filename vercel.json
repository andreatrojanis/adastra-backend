{
  "version": 2,
  "functions": {
    "api/analyze.js": {
      "maxDuration": 120
    },
    "api/analyze-mirage.js": {
      "maxDuration": 300
    },
    "api/docx.js": {
      "maxDuration": 60
    },
    "api/generate.js": {
      "maxDuration": 300
    },
    "api/generate-on.js": {
      "maxDuration": 300
    },
    "api/docx-on.js": {
      "maxDuration": 60
    },
    "api/log-acceptance.js": {
      "maxDuration": 10
    },
    "api/platform-closed.js": {
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "^/(?:landing\\.html)?$",
      "methods": [
        "GET",
        "HEAD"
      ],
      "headers": {
        "Cache-Control": "no-cache"
      },
      "dest": "/landing.html"
    },
    {
      "src": "^/robots\\.txt$",
      "methods": [
        "GET",
        "HEAD"
      ],
      "dest": "/robots.txt"
    },
    {
      "src": "^/favicon\\.ico$",
      "methods": [
        "GET",
        "HEAD"
      ],
      "status": 204
    },
    {
      "src": "^/.*$",
      "headers": {
        "Cache-Control": "no-store, max-age=0",
        "X-Robots-Tag": "noindex, nofollow",
        "Retry-After": "3600"
      },
      "dest": "/api/platform-closed"
    }
  ]
}
